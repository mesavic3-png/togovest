generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  OWNER
  AGENT
  AGENCY_ADMIN
  ADMIN
}

enum PropertyStatus {
  DRAFT
  PENDING
  PUBLISHED
  SOLD
  RENTED
  ARCHIVED
}

enum TransactionType {
  SALE
  RENT
  SHORT_TERM
}

enum PropertyType {
  HOUSE
  APARTMENT
  LAND
  VILLA
  OFFICE
  SHOP
  WAREHOUSE
  OTHER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELED
  COMPLETED
}

enum PlanCode {
  FREE
  PRO
  AGENCY
}

enum SubscriptionStatus {
  INACTIVE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentType {
  SUBSCRIPTION
  BOOST
  FEATURED
}

enum AdvertisementPlacement {
  HOME_BANNER
  SEARCH_INLINE
  PREMIUM
}

enum AdvertisementStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  ENDED
}

enum AdvertisingRequestStatus {
  NEW
  CONTACTED
  APPROVED
  REJECTED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id String @id @default(cuid())
  name String
  email String? @unique
  passwordHash String?
  emailVerifiedAt DateTime? @default(now())
  phone String? @unique
  role UserRole @default(USER)
  isActive Boolean @default(true)
  agencyId String?
  agency Agency? @relation(fields: [agencyId], references: [id])
  properties Property[]
  favorites Favorite[]
  inquiries Inquiry[]
  bookings Booking[]
  subscription Subscription?
  payments Payment[]
  authTokens AuthToken[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuthToken {
  id String @id @default(cuid())
  tokenHash String @unique
  type AuthTokenType
  expiresAt DateTime
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

model Agency {
  id String @id @default(cuid())
  name String
  slug String @unique
  email String?
  phone String?
  logoUrl String?
  website String?
  description String?
  verified Boolean @default(false)
  members User[]
  properties Property[]
  subscription Subscription?
  payments Payment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id String @id @default(cuid())
  plan PlanCode @default(FREE)
  status SubscriptionStatus @default(INACTIVE)
  provider String @default("stripe")
  providerCustomerId String?
  providerSubscriptionId String? @unique
  currentPeriodEnd DateTime?
  cancelAtPeriodEnd Boolean @default(false)
  userId String? @unique
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  agencyId String? @unique
  agency Agency? @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id String @id @default(cuid())
  type PaymentType
  plan PlanCode?
  status PaymentStatus @default(PENDING)
  amount Int
  currency String @default("XOF")
  provider String @default("stripe")
  providerPaymentId String? @unique
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  agencyId String?
  agency Agency? @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  propertyId String?
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, createdAt])
  @@index([agencyId, createdAt])
}

model Property {
  id String @id @default(cuid())
  title String
  slug String @unique
  description String
  type PropertyType
  transactionType TransactionType
  status PropertyStatus @default(DRAFT)
  price Decimal @db.Decimal(18, 2)
  currency String @default("XOF")
  nightlyPrice Decimal? @db.Decimal(18, 2)
  weeklyPrice Decimal? @db.Decimal(18, 2)
  monthlyPrice Decimal? @db.Decimal(18, 2)
  cleaningFee Decimal? @db.Decimal(18, 2)
  securityDeposit Decimal? @db.Decimal(18, 2)
  minNights Int?
  maxGuests Int?
  checkInTime String?
  checkOutTime String?
  city String
  district String?
  address String?
  latitude Float?
  longitude Float?
  bedrooms Int?
  bathrooms Int?
  areaSqm Float?
  landAreaSqm Float?
  furnished Boolean @default(false)
  amenities String[] @default([])
  parkingSpaces Int?
  isFeatured Boolean @default(false)
  featuredUntil DateTime?
  boostUntil DateTime?
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  agencyId String?
  agency Agency? @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  images PropertyImage[]
  favorites Favorite[]
  inquiries Inquiry[]
  payments Payment[]
  bookings Booking[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, transactionType, type])
  @@index([city, district])
  @@index([price])
  @@index([isFeatured, featuredUntil])
}

model Booking {
  id String @id @default(cuid())
  propertyId String
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkIn DateTime
  checkOut DateTime
  guests Int
  nights Int
  totalAmount Decimal @db.Decimal(18, 2)
  currency String @default("XOF")
  status BookingStatus @default(PENDING)
  guestName String?
  guestPhone String?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([propertyId, checkIn, checkOut])
  @@index([userId, createdAt])
}

model PropertyImage {
  id String @id @default(cuid())
  url String
  alt String?
  sortOrder Int @default(0)
  propertyId String
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([propertyId, sortOrder])
}

model Favorite {
  userId String
  propertyId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([userId, propertyId])
}

model Inquiry {
  id String @id @default(cuid())
  name String?
  email String?
  message String
  phone String?
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  propertyId String
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([propertyId, createdAt])
}

model Advertisement {
  id String @id @default(cuid())
  advertiserName String
  title String
  description String?
  imageUrl String?
  destinationUrl String
  placement AdvertisementPlacement
  status AdvertisementStatus @default(DRAFT)
  startsAt DateTime?
  endsAt DateTime?
  impressions Int @default(0)
  clicks Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([placement, status, startsAt, endsAt])
}

model AdvertisingRequest {
  id String @id @default(cuid())
  companyName String
  contactName String
  email String
  phone String?
  website String?
  placement AdvertisementPlacement
  durationWeeks Int @default(1)
  message String?
  status AdvertisingRequestStatus @default(NEW)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
}
