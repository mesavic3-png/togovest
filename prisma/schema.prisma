generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  OWNER
  AGENT
  AGENCY_ADMIN
  ADMIN
}

enum PropertyStatus {
  DRAFT
  PENDING
  PUBLISHED
  SOLD
  RENTED
  ARCHIVED
}

enum TransactionType {
  SALE
  RENT
}

enum PropertyType {
  HOUSE
  APARTMENT
  LAND
  VILLA
  OFFICE
  SHOP
  WAREHOUSE
  OTHER
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String?
  phone        String?
  role         UserRole   @default(USER)
  isActive     Boolean    @default(true)
  agencyId     String?
  agency       Agency?    @relation(fields: [agencyId], references: [id])
  properties   Property[]
  favorites    Favorite[]
  inquiries    Inquiry[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Agency {
  id         String     @id @default(cuid())
  name       String
  slug       String     @unique
  email      String?
  phone      String?
  logoUrl    String?
  verified   Boolean    @default(false)
  members    User[]
  properties Property[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Property {
  id              String          @id @default(cuid())
  title           String
  slug            String          @unique
  description     String
  type            PropertyType
  transactionType TransactionType
  status          PropertyStatus  @default(DRAFT)
  price           Decimal         @db.Decimal(18, 2)
  currency        String          @default("XOF")
  city            String
  district        String?
  address         String?
  latitude        Float?
  longitude       Float?
  bedrooms        Int?
  bathrooms       Int?
  areaSqm         Float?
  landAreaSqm     Float?
  furnished       Boolean         @default(false)
  parkingSpaces   Int?
  ownerId         String
  owner           User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  agencyId        String?
  agency          Agency?         @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  images          PropertyImage[]
  favorites       Favorite[]
  inquiries       Inquiry[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status, transactionType, type])
  @@index([city, district])
  @@index([price])
}

model PropertyImage {
  id         String   @id @default(cuid())
  url        String
  alt        String?
  sortOrder  Int      @default(0)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([propertyId, sortOrder])
}

model Favorite {
  userId     String
  propertyId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, propertyId])
}

model Inquiry {
  id         String   @id @default(cuid())
  message    String
  phone      String?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([propertyId, createdAt])
}
